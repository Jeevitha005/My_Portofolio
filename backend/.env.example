FLASK_ENV=development
# MySQL: mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME   |  Postgres: postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/portfolio
FRONTEND_ORIGIN=http://localhost:5173
# Optional email notifications (https://resend.com). Leave blank to disable.
RESEND_API_KEY=
NOTIFY_TO_EMAIL=
NOTIFY_FROM_EMAIL=onboarding@resend.dev
# Long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Used only by `flask --app app create-admin` (password >= 12 chars). Remove after use.
ADMIN_EMAIL=
ADMIN_PASSWORD=
